# Kopieer dit bestand naar .env.local (wordt niet gecommit) en vul je eigen account in.
# Dan log je op localhost automatisch in tijdens `npm run dev`.
# Bewust geen VITE_-prefix: zulke variabelen komen in de client-bundel terecht.
# Werkt alleen met de dev-server op localhost, nooit in een build.
DEV_LOGIN_EMAIL=
DEV_LOGIN_PASSWORD=
